---
layout: base.njk
---
<article class="study">
  <header class="study-head wrap narrow">
    <a class="back" href="/studies/">← All studies</a>
    {% if passage %}<p class="eyebrow">{{ passage }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}
    <p class="meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      <span aria-hidden="true">·</span> {{ content | readingTime }}
      {% for t in topics %}<span class="tag">{{ t }}</span>{% endfor %}
    </p>
  </header>
  <div class="prose wrap narrow">
    {{ content | safe }}
  </div>
  {% if pdf %}
  <div class="wrap narrow">
    <a class="download" href="/files/{{ pdf }}" download>
      <span class="download-icon" aria-hidden="true">↓</span>
      <span><strong>Download this study</strong><small>PDF · for print or group use</small></span>
    </a>
  </div>
  {% endif %}
  {% set prev = collections.studies | getNextCollectionItem(page) %}
  {% set next = collections.studies | getPreviousCollectionItem(page) %}
  {% if prev or next %}
  <nav class="pager wrap narrow" aria-label="More studies">
    {% if prev %}<a class="pager-link" href="{{ prev.url }}"><small>← Older</small>{{ prev.data.title }}</a>{% else %}<span></span>{% endif %}
    {% if next %}<a class="pager-link right" href="{{ next.url }}"><small>Newer →</small>{{ next.data.title }}</a>{% endif %}
  </nav>
  {% endif %}
</article>
